PORT=4000
FRONTEND_URL=http://localhost:3000
# Local development uses a persistent SQLite file. Production requires PostgreSQL.
# DATABASE_URL=postgresql://pletosie:password@localhost:5432/pletosie
DATABASE_SSL=false
SEED_DEMO=true
COMMERCE_ENABLED=false
DELIVERY_ZONES=[]
# Google OAuth web client, server-side credentials only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Explicitly authorized Gmail/Google Workspace administrator address.
GOOGLE_ADMIN_EMAIL=
# These integrations remain disabled until verified with merchant credentials.
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
FEEXPAY_ENABLED=false
FEEXPAY_MODE=sandbox
FEEXPAY_OPERATORS=
FEEXPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Validate commercial policy before activation.
CANCELLATION_POLICY=
HOST=127.0.0.1
# Web Push VAPID keys. Generate once, keep the private key server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
